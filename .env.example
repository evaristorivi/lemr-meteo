# Parámetros web
WEB_HOST=127.0.0.1
WEB_PORT=8001

# OpenAI API Key (OPCIONAL - Solo si no usas GitHub Models)
# OPENAI_API_KEY=tu_api_key_aqui

# Proveedor de IA preferido: 'gemini', 'openai' 
AI_PROVIDER=gemini
GEMINI_API_KEY=tu_key_de_aistudio

# ⚙️ SISTEMA DE CASCADA AUTOMÁTICA DE MODELOS ⚙️
# El sistema prueba modelos en este orden (definido en config.py):
#   1. gpt-4o (mejor calidad, límite: 50/día)
#   2. gpt-4o-mini (buena calidad, límite: 150/día) 
#   3. meta-llama-3.1-405b-instruct (open source potente)
#   4. phi-4 (modelo pequeño Microsoft)
# 
# El sistema cambia automáticamente al siguiente disponible.


# AEMET OpenData API Key (gratuita, registrarse en https://opendata.aemet.es)
# Opcional pero MUY RECOMENDADA: sin ella no tendrás predicciones textuales de AEMET
# (los mapas significativos sí funcionan sin API key)
AEMET_API_KEY=tu_aemet_api_key_aqui

# Windy Point Forecast API Key (https://api.windy.com/keys)
WINDY_POINT_FORECAST_API_KEY=tu_windy_point_forecast_key_aqui

# Modelo Windy recomendado para Europa: gfs o iconEu
WINDY_MODEL=gfs

# 📱 Alertas Telegram (OPCIONAL)
# Si no se configuran, el sistema funciona con normalidad sin enviar alertas.

# TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TELEGRAM_CHAT_ID=123456789
