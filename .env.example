# Parámetros web
WEB_HOST=127.0.0.1
WEB_PORT=8001

# OpenAI API Key (OPCIONAL - Solo si prefieres OpenAI en vez de Gemini)
# OPENAI_API_KEY=tu_api_key_aqui

# Proveedor de IA preferido: 'gemini', 'openai'
AI_PROVIDER=gemini
GEMINI_API_KEY=tu_key_de_aistudio

# ⚙️ SISTEMA DE CASCADA AUTOMÁTICA DE MODELOS ⚙️
# El sistema prueba modelos en este orden (definido en config.py):
#   1. gemini-3.6-flash
#   2. gemini-3.5-flash
#   3. gemini-3.5-flash-lite
#   4. gemini-3.1-flash-lite
#   5. gemini-3-flash-preview
#   6. gemini-3.8-flash       (más nuevo, pero saturado/503 en tier gratis ahora mismo)
#   7. gemini-3.7-flash       (ídem)
#
# El sistema cambia automáticamente al siguiente disponible.


# AEMET OpenData API Key (gratuita, registrarse en https://opendata.aemet.es)
# Opcional pero MUY RECOMENDADA: sin ella la IA no recibe los avisos CAP de Asturias
# (los mapas AEMET funcionan sin API key: los descarga el servidor de la web pública)
AEMET_API_KEY=tu_aemet_api_key_aqui

# Caché de mapas AEMET (OPCIONAL). Por defecto <app>/cache/{sigwx,vtplot,analisis};
# el usuario del servicio (www-data) debe poder escribir en ella.
# SIGWX_CACHE_DIR=/var/www/lemr-meteo/cache/sigwx
# VTPLOT_CACHE_DIR=/var/www/lemr-meteo/cache/vtplot
# ANALISIS_CACHE_DIR=/var/www/lemr-meteo/cache/analisis
# Horas que tarda AEMET en publicar un mapa significativo tras su hora de emisión
# SIG_MAP_PUBLISH_LAG_H=3

# Windy Point Forecast API Key (https://api.windy.com/keys)
WINDY_POINT_FORECAST_API_KEY=tu_windy_point_forecast_key_aqui

# Modelo Windy recomendado para Europa: gfs o iconEu
WINDY_MODEL=gfs

# 📱 Alertas Telegram (OPCIONAL)
# Si no se configuran, el sistema funciona con normalidad sin enviar alertas.

# TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TELEGRAM_CHAT_ID=123456789
